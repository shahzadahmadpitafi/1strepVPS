# Copy this file to .env on the VPS and fill in real values.
# Nothing here is committed to git — .env is gitignored.

# ── Core ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://1strep:CHANGE_ME@localhost:5432/1strep
DATABASE_SSL=false          # local Postgres on this VPS doesn't use SSL; set true for a managed/remote DB
SESSION_SECRET=              # random long string, e.g: openssl rand -hex 32
SECRET_KEY=                  # random long string, used to encrypt stored Stripe/Square credentials
BASE_URL=https://yourdomain.com
COOKIE_SECURE=                # leave unset once HTTPS is live; set to "false" only for temporary http:// testing

# ── File storage ────────────────────────────────────────────────────────────
# Local disk storage is the default — no setup needed, files are written under
# ./object_storage (override the directory with UPLOAD_DIR if you want).
# UPLOAD_DIR=/var/www/1strep/object_storage
#
# To use Cloudflare R2 instead, set all four of these and local disk is skipped:
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# ── Google login (optional — app boots fine without it, button just 503s) ──
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_CALLBACK_DOMAIN=yourdomain.com

# ── Stripe ───────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── PayPal ───────────────────────────────────────────────────────────────────
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── Square (card payments + in-person EPOS terminal) ────────────────────────
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=
SQUARE_OAUTH_SECRET=
SQUARE_TERMINAL_DEVICE_ID=

# ── Outgoing email (tried in this order: SMTP, then Gmail) ─────────────────
SMTP_HOST=smtp.123-reg.co.uk
SMTP_PORT=465
SMTP_USER=info@1strep.com
SMTP_PASSWORD=
# Fallback only used if SMTP_PASSWORD is not set:
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

# ── SMS (optional, Twilio) ───────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Admin SMS alerts — new order + new feedback notifications, sent here in
# addition to the usual admin bell/panel entry. Comma-separate for more than
# one number (e.g. "+447500000000,+447500000001"). Leave unset to disable.
# ADMIN_ALERT_PHONE=

# ── Push notifications (optional — auto-generates + stores its own VAPID
# keys in the DB on first boot if these are left unset) ────────────────────
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:info@1strep.com

# ── AI chatbot (optional) ────────────────────────────────────────────────────
# OPENAI_API_KEY=
